/* Neon-on-navy theme. */
$bg: #0b0f1a;
$surface: #121829;
$accent: #22d3ee;
$profit: #22c55e;
$loss: #ef4444;
$pending: #f59e0b;

Screen {
    background: $bg;
    color: #e2e8f0;
    layout: vertical;
}

BankrollHeader {
    width: 1fr;
    height: 1;
    padding: 0 1;
    background: $surface;
    color: $accent;
    text-style: bold;
}

#info-line {
    width: 1fr;
    height: auto;
    padding: 0 1;
    background: $surface;
    color: #94a3b8;
}

#tabs { height: 1fr; }
#tabs TabPane { padding: 0; }
#tabs Tabs { background: $bg; }
#tabs Tab.-active { color: $accent; text-style: bold; }

#home { layout: vertical; }
#place-box { height: 3fr; }
#open-box { height: 2fr; }
#watch-box { height: 2fr; }
#watch-box.is-empty { height: auto; }
#watch-box .empty { padding: 0 1; }
#place-box, #open-box, #watch-box {
    background: $surface;
    border: round $accent 40%;
    border-title-color: $accent;
    border-title-style: bold;
}
#place-box:focus-within { border: round $accent; }
#open-box:focus-within { border: round $accent; }
#watch-box:focus-within { border: round $accent; }
#watch-box { border: round $pending 30%; border-title-color: $pending; }
PlaceNowList, OpenBetsList, WatchList {
    height: 1fr;
    background: $surface;
    border: none;
    padding: 0;
}
PlaceNowList > .option-list--option { padding: 0 1; }
OpenBetsList > .option-list--option { padding: 0 1; }
WatchList > .option-list--option { padding: 0 1; }
.summary {
    height: auto;
    padding: 0 1;
    color: $accent;
}
.empty {
    height: auto;
    padding: 1 2;
    color: #94a3b8;
}

#pp-status {
    height: auto;
    padding: 0 2;
    color: #94a3b8;
}
#pp-scroll { height: 1fr; background: $surface; }
#pp-board { padding: 1 2; }

#performance { layout: vertical; }
#perf-top { height: 16; }
BalanceChart { width: 1fr; height: 1fr; }
PerfMoney { width: 36; height: 1fr; padding: 1 1; }
#perf-scroll { height: 1fr; }
PerfTables { height: auto; padding: 0 1; }
ScoresPanel, EventLog { height: 1fr; }
QuotaBar { width: 1fr; }

#status {
    height: 1;
    padding: 0 1;
    color: #94a3b8;
    background: $bg;
}

#command-bar {
    height: auto;
}

.panel {
    background: $surface;
    border: round $accent 40%;
}

BalanceChart, PerfMoney, PerfTables, KpiTiles, QuotaBar, ScoresPanel, EventLog {
    background: $surface;
    border: round $accent 40%;
}

KpiTiles { height: auto; padding: 0 1; }
QuotaBar { height: auto; padding: 0 1; }
QuotaBar.low { color: $loss; }
ScoresPanel > .option-list--option { padding: 0 1; }
ScoresPanel > .option-list--option-disabled { padding: 0 1; color: $accent; }

.profit { color: $profit; }
.loss { color: $loss; }
.pending { color: $pending; }

/* Modals must not inherit the dashboard grid from the Screen rule above. */
ModalScreen {
    layout: vertical;
}

ConfirmScreen {
    align: center middle;
    background: $bg 70%;
}

#confirm-box {
    width: 60;
    max-width: 96%;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: round $accent;
}

#confirm-box Input { margin-bottom: 1; }
#error { color: $loss; height: auto; }
#buttons { height: auto; align-horizontal: right; }

WhyScreen {
    align: center middle;
    background: $bg 70%;
}

#why-box {
    width: 90;
    max-width: 96%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: $surface;
    border: round $accent;
}

#why-title { color: $accent; text-style: bold; margin-bottom: 1; }
#why-body { height: auto; }
#why-details { height: auto; color: #64748b; margin-top: 1; }
#buttons Button { margin-left: 2; }
