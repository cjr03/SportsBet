/* Neon-on-navy theme. */
$bg: #0b0f1a;
$surface: #121829;
$accent: #22d3ee;
$profit: #22c55e;
$loss: #ef4444;
$pending: #f59e0b;

Screen {
    background: $bg;
    color: #e2e8f0;
    layout: vertical;
}

BankrollHeader {
    width: 1fr;
    height: 1;
    padding: 0 1;
    background: $surface;
    color: $accent;
    text-style: bold;
}

#info-line {
    width: 1fr;
    height: auto;
    padding: 0 1;
    background: $surface;
    color: #94a3b8;
}

#tabs { height: 1fr; }
#tabs TabPane { padding: 0; }
#tabs Tabs { background: $bg; }
#tabs Tab.-active { color: $accent; text-style: bold; }

/* Home scrolls as one page: every box is as tall as its rows, each list capped so the rest stays near */
#home-scroll { height: 1fr; scrollbar-size-vertical: 1; }
#place-box, #open-box, #watch-box { height: auto; }
#watch-box .empty { padding: 0 1; }
#place-box, #open-box, #watch-box {
    background: $surface;
    border: round $accent 40%;
    border-title-color: $accent;
    border-title-style: bold;
}
#place-box:focus-within { border: round $accent; }
#open-box:focus-within { border: round $accent; }
#watch-box:focus-within { border: round $accent; }
#watch-box { border: round $pending 30%; border-title-color: $pending; }
PlaceNowList, OpenBetsList, WatchList {
    height: auto;
    background: $surface;
    border: none;
    padding: 0;
}
#place-now { max-height: 12; }
#open-bets { max-height: 10; }
PlaceNowList > .option-list--option { padding: 0 1; }
OpenBetsList > .option-list--option { padding: 0 1; }
WatchList > .option-list--option { padding: 0 1; }
.summary {
    height: auto;
    padding: 0 1;
    color: $accent;
}
.empty {
    height: auto;
    padding: 1 2;
    color: #94a3b8;
}

#pp-summary-box, #pp-plays-box, #pp-entry-box, #pp-scroll { height: auto; }
#pp-summary-box, #pp-plays-box, #pp-entry-box, #pp-scroll {
    background: $surface;
    border: round $accent 40%;
    border-title-color: $accent;
    border-title-style: bold;
}
#pp-plays-box { border: round $profit 40%; border-title-color: $profit; }
#pp-entry-box { border: round $pending 40%; border-title-color: $pending; }
#pp-entry-scroll { height: auto; max-height: 35vh; }
#home.-short #pp-entry-scroll { max-height: 25vh; }
#pp-entry-keys { height: auto; padding: 0 1; color: $pending; }
#pp-scroll:focus-within { border: round $accent; }
#pp-plays-box:focus-within { border: round $profit; }
#pp-entry-box:focus-within { border: round $pending; }
#pp-summary, #pp-entry { padding: 0 1; }
#pp-plays-empty, #pp-plays-note { padding: 0 1; }
#pp-plays-note { height: auto; color: $pending; }
PickList, PlayList { background: $surface; border: none; padding: 0; }
PickList:focus, PlayList:focus { border: none; }
#pp-plays { height: auto; max-height: 10; }
#home.-short #pp-plays { max-height: 4; }
#home.-short.-picking #pp-plays { max-height: 2; }
#home.-short.-picking #pp-board { max-height: 22vh; }
#pp-board { height: auto; min-height: 4; max-height: 60vh; }
PickList > .option-list--option, PlayList > .option-list--option { padding: 0 1; }
PickList > .option-list--option-disabled { padding: 0 1; }

#performance { layout: vertical; }
#perf-top { height: 16; }
BalanceChart { width: 1fr; height: 1fr; }
PerfMoney { width: 36; height: 1fr; padding: 1 1; }
#perf-scroll { height: 1fr; }
PerfTables { height: auto; padding: 0 1; }
ScoresPanel, EventLog { height: 1fr; }
QuotaBar { width: 1fr; }

#status {
    height: 1;
    padding: 0 1;
    color: #94a3b8;
    background: $bg;
}

#command-bar {
    height: auto;
}

.panel {
    background: $surface;
    border: round $accent 40%;
}

BalanceChart, PerfMoney, PerfTables, KpiTiles, QuotaBar, ScoresPanel, EventLog {
    background: $surface;
    border: round $accent 40%;
}

KpiTiles { height: auto; padding: 0 1; }
QuotaBar { height: auto; padding: 0 1; }
QuotaBar.low { color: $loss; }
ScoresPanel > .option-list--option { padding: 0 1; }
ScoresPanel > .option-list--option-disabled { padding: 0 1; color: $accent; }

.profit { color: $profit; }
.loss { color: $loss; }
.pending { color: $pending; }

/* Modals must not inherit the dashboard grid from the Screen rule above. */
ModalScreen {
    layout: vertical;
}

ConfirmScreen, AskScreen {
    align: center middle;
    background: $bg 70%;
}

#confirm-box {
    width: 60;
    max-width: 96%;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: round $accent;
}

#confirm-box Input { margin-bottom: 1; }
#confirm-title { width: 1fr; height: auto; }
#error { color: $loss; height: auto; }
#confirm-warning { color: $pending; height: auto; margin-bottom: 1; }
#ask-text { height: auto; margin-bottom: 1; }
#buttons { height: auto; align-horizontal: right; }

WhyScreen {
    align: center middle;
    background: $bg 70%;
}

#why-box {
    width: 90;
    max-width: 96%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: $surface;
    border: round $accent;
}

#why-title { color: $accent; text-style: bold; margin-bottom: 1; }
#why-body { height: auto; }
#why-details { height: auto; color: #64748b; margin-top: 1; }
#buttons Button { margin-left: 2; }
